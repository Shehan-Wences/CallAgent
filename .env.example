OPENAI_API_KEY=sk-replace-me
MODEL=gpt-realtime-mini

# --- Phone calls via Twilio (optional; only needed for "Call phone") ---
# A Twilio account, auth token, and a Twilio number to call FROM.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public hostname Twilio can reach (NOT localhost). For local testing run a
# tunnel, e.g. `ngrok http 8000`, and put the host here (no scheme, no slash):
#   PUBLIC_HOST=abc123.ngrok-free.app
PUBLIC_HOST=

# --- Voice-activity tuning (optional) ---
# Raise VAD_THRESHOLD toward 0.8 if the agent still interrupts on small sounds.
# VAD_THRESHOLD=0.6
# VAD_SILENCE_MS=800
# VAD_INTERRUPT=true
